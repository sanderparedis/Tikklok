{
  "entities": {
    "WorkEntry": {
      "title": "Work Entry",
      "description": "A record of time worked on a specific date, categorized into ICT or Teaching.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "startTime": { "type": "string", "description": "HH:mm format" },
        "endTime": { "type": "string", "description": "HH:mm format" },
        "breakTime": { "type": "number", "description": "Break time in minutes" },
        "category": { "type": "string", "enum": ["ict", "teaching"], "description": "Work category" },
        "description": { "type": "string", "description": "Optional description of activity" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "date", "startTime", "endTime", "breakTime"]
    },
    "TravelEntry": {
      "title": "Travel Entry",
      "description": "A record of professional travel (Preset, Nascholing, or Woon-werk).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "description": { "type": "string" },
        "distance": { "type": "number" },
        "type": { "type": "string", "enum": ["auto", "fiets"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "date", "description", "distance", "type"]
    },
    "UserTimer": {
      "title": "User Timer State",
      "description": "The active timer state for a user.",
      "type": "object",
      "properties": {
        "isActive": { "type": "boolean" },
        "startTime": { "type": "number", "description": "Timestamp in ms" }
      },
      "required": ["isActive"]
    },
    "FreeDay": {
      "title": "Free Day",
      "description": "A record of a non-working day (e.g., holiday, sick leave).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "type": { "type": "string", "enum": ["vrije/facultatieve dag", "ziek", "feestdag"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "date", "type"]
    },
    "VacationPeriod": {
      "title": "Vacation Period",
      "description": "A manually entered long vacation period where no work is expected.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "startDate", "endDate", "description"]
    },
    "UserSettings": {
      "title": "User Schedule Settings",
      "description": "User specific appointment breakdown and weekly teaching schedule.",
      "type": "object",
      "properties": {
        "adminNumerator": { "type": "number", "description": "ICT appointment hours numerator" },
        "teachingNumerator": { "type": "number", "description": "Teaching appointment hours numerator" },
        "denominator": { "type": "number", "description": "Full-time denominator hours (e.g. 21)" },
        "fulltimeWeekHours": { "type": "number", "description": "Weekly norm hours (e.g. 36)" },
        "teachingLessonsPerDay": { "type": "object", "description": "Map of weekday to teaching lessons" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["adminNumerator", "teachingNumerator", "denominator", "fulltimeWeekHours"]
    }
  },
  "firestore": {
    "/users/{userId}/settings/{settingId}": {
      "schema": "UserSettings",
      "description": "User custom schedule and distribution settings."
    },
    "/users/{userId}/workEntries/{entryId}": {
      "schema": "WorkEntry",
      "description": "Work history for a user."
    },
    "/users/{userId}/travelEntries/{entryId}": {
      "schema": "TravelEntry",
      "description": "Travel history for a user."
    },
    "/users/{userId}/freeDays/{dayId}": {
      "schema": "FreeDay",
      "description": "Free days history for a user."
    },
    "/users/{userId}/vacationPeriods/{vacationId}": {
      "schema": "VacationPeriod",
      "description": "Vacation periods history for a user."
    },
    "/users/{userId}": {
      "schema": "UserTimer",
      "description": "User profile and active timer state."
    }
  }
}
